{
  "name": "picnic-ball",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/index.ts\" \"vite --host 0.0.0.0\"",
    "build": "tsc --noEmit && vite build && node scripts/build.mjs",
    "start": "node build/server.mjs",
    "start:source": "tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "verify:browser": "tsx scripts/browser-check.ts"
  },
  "dependencies": {
    "phaser": "^3.90.0",
    "three": "^0.187.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/three": "^0.187.0",
    "@types/ws": "^8.18.0",
    "concurrently": "^9.2.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.56.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0"
  }
}
